{
  "name": "customer-spending-insights-dashboard",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\"",
    "lint": "oxlint src",
    "typecheck": "tsc --noEmit",
    "validate": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build",
    "docker": "docker rm -f spending-insights-dashboard 2>/dev/null; docker build -t spending-insights-dashboard . && docker run -d --name spending-insights-dashboard -p 8080:80 spending-insights-dashboard && echo 'Running at http://localhost:8080'"
  },
  "dependencies": {
    "lucide-react": "^0.446.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4",
    "recharts": "^2.12.7"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "@vitest/ui": "^4.1.11",
    "autoprefixer": "^10.4.20",
    "jsdom": "^29.1.1",
    "oxlint": "^1.85.0",
    "postcss": "^8.4.45",
    "prettier": "^3.9.8",
    "tailwindcss": "^3.4.12",
    "typescript": "^5.5.3",
    "vite": "^5.4.3",
    "vitest": "^4.1.11"
  }
}
